{
  "manifest_version": 3,
  "name": "FocusMask – Focus Sounds & White Noise",
  "short_name": "FocusMask",
  "version": "1.0.0",
  "description": "One-click brown, pink & white noise plus nature sounds that auto-pause when another tab plays audio. Offline & private.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusMask",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["offscreen", "storage", "unlimitedStorage", "alarms", "notifications", "idle"],
  "commands": {
    "toggle-playback": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Play / pause the ambient sound"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
