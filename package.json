{
  "name": "focusmask",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "zip": "node scripts/zip.mjs",
    "deploy": "node scripts/deploy.js",
    "deploy:patch": "node scripts/deploy.js patch",
    "deploy:minor": "node scripts/deploy.js minor",
    "deploy:major": "node scripts/deploy.js major",
    "upload": "node scripts/deploy.js --skip-submit",
    "assets": "node scripts/store-assets.mjs",
    "release": "npm run test && npm run test:e2e && npm run zip",
    "site": "node scripts/site.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "archiver": "^8.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
